  bookPages:
  - "\u306F\u3058\u3081\u65B9\n\n\u53C2\u52A0\u3067\u304D\u308B\u4EBA\u9593\u306F1\u301C4\u4EBA\u3002\n\u300C\u53C2\u52A0\u300D\u2192\u300C\u914D\u672D\u300D\u3067\u958B\u59CB\u3057\u307E\u3059\u3002\nCPU\u88DC\u5145ON\u306A\u3089\u3001\u7A7A\u5E2D\u3092CPU\u304C\u57CB\u3081\u30664\u4EBA\u6226\u3002\nCPU\u88DC\u5145OFF\u306A\u3089\u3001\u4EBA\u95932\u301C4\u4EBA\u3067\u5BFE\u6226\u3057\u307E\u3059\u3002"
  - "\u30AB\u30FC\u30C9\u306E\u51FA\u3057\u65B9\n\n\u624B\u672D\u306F\u6247\u72B6\u306B\u4E26\u3073\u307E\u3059\u3002\u62BC\u3059\u3068\u9078\u629E\u3055\u308C\u307E\u3059\u3002\n\u9078\u629E\u3057\u305F\u30AB\u30FC\u30C9\u304C\u4E0A\u306B\u6301\u3061\u4E0A\u304C\u308A\u307E\u3059\u3002\n\u300C\u51FA\u3059
    / \u78BA\u5B9A\u300D\u3067\u63D0\u51FA\u3001\u300C\u30D1\u30B9\u300D\u3067\u898B\u9001\u308A\u307E\u3059\u3002\n\u5834\u3068\u540C\u3058\u679A\u6570\u30FB\u540C\u3058\u5F62\u3067\u3001\u3088\u308A\u5F37\u3044\u672D\u3092\u51FA\u3057\u307E\u3059\u3002"
  - "\u5F37\u3055\u3068\u5834\u306E\u6D41\u308C\n\n\u901A\u5E38\u306F3\u304C\u6700\u5F31\u30012\u304C\u6700\u5F37\u3002\u30B8\u30E7\u30FC\u30AB\u30FC\u306F\u5358\u4F53\u6700\u5F37\u3002\n\u30D1\u30B9\u3057\u305F\u4EBA\u306F\u3001\u305D\u306E\u5834\u304C\u6D41\u308C\u308B\u307E\u3067\u5FA9\u5E30\u3067\u304D\u307E\u305B\u3093\u3002\n\u6700\u5F8C\u306B\u51FA\u3057\u305F\u4EBA\u3078\u623B\u308B\u3068\u5834\u304C\u6D41\u308C\u307E\u3059\u3002\n\u624B\u672D\u3092\u306A\u304F\u3057\u305F\u9806\u306B\u9806\u4F4D\u304C\u6C7A\u307E\u308A\u307E\u3059\u3002"
  - "10\u6368\u3066 / 7\u6E21\u3057\n\n10\uFF1A\u51FA\u3057\u305F\u679A\u6570\u3060\u3051\u3001\u81EA\u5206\u306E\u624B\u672D\u3092\u9078\u3093\u3067\u6368\u3066\u307E\u3059\u3002\n7\uFF1A\u51FA\u3057\u305F\u679A\u6570\u3060\u3051\u3001\u6B21\u306E\u76F8\u624B\u3078\u624B\u672D\u3092\u6E21\u3057\u307E\u3059\u3002\n\u3069\u3061\u3089\u3082\u30AB\u30FC\u30C9\u3092\u9078\u3093\u3067\u300C\u51FA\u3059
    / \u78BA\u5B9A\u300D\u3002\n\u624B\u672D\u304C\u8DB3\u308A\u306A\u3044\u5834\u5408\u306F\u6B8B\u308A\u3059\u3079\u3066\u3092\u9078\u3073\u307E\u3059\u3002"
  - "12\u30DC\u30F3\u30D0\u30FC / 5\u30B9\u30AD\u30C3\u30D7\n\nQ\uFF1A\u6570\u5B57\u3092\u6307\u5B9A\u3057\u3001\u5168\u54E1\u304B\u3089\u305D\u306E\u6570\u5B57\u3092\u9664\u304D\u307E\u3059\u3002\nQ\u306E\u679A\u6570\u3060\u3051\u6307\u5B9A\u3067\u304D\u307E\u3059\u3002JOKER\u306F\u5BFE\u8C61\u5916\u3067\u3059\u3002\n5\uFF1A\u51FA\u3057\u305F\u679A\u6570\u3060\u3051\u672A\u30D1\u30B9\u306E\u76F8\u624B\u3092\u98DB\u3070\u3057\u307E\u3059\u3002\n\u4E00\u5468\u3057\u3066\u81EA\u5206\u306E\u624B\u756A\u306B\u306A\u308B\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002"
  - "8\u5207\u308A / \u30B9\u30DA3\u8FD4\u3057\n\n8\u3092\u542B\u3080\u672D\u3092\u51FA\u3059\u3068\u3001\u5834\u304C\u6D41\u308C\u307E\u3059\u3002\n\u305D\u306E\u4EBA\u304C\u4E0A\u304C\u3063\u3066\u3044\u305F\u3089\u3001\u6B21\u306E\u4EBA\u304B\u3089\u518D\u958B\u3057\u307E\u3059\u3002\n\u5358\u4F53\u30B8\u30E7\u30FC\u30AB\u30FC\u306B\u306F\u30B9\u30DA\u30FC\u30C93\u3067\u8FD4\u305B\u307E\u3059\u3002\n\u30B9\u30DA3\u8FD4\u3057\u306F\u7E1B\u308A\u3092\u7121\u8996\u3057\u3066\u5834\u3092\u6D41\u3057\u307E\u3059\u3002"
  - "\u9769\u547D / J\u30D0\u30C3\u30AF\n\n\u540C\u3058\u6570\u5B574\u679A\u4EE5\u4E0A\u3067\u9769\u547D\u3002\u5F37\u3055\u304C\u53CD\u8EE2\u3057\u307E\u3059\u3002\nJ\u3092\u542B\u3080\u3068\u3001\u3053\u306E\u5834\u3060\u3051\u5F37\u3055\u3092\u53CD\u8EE2\u3057\u307E\u3059\u3002\nJ\u30D0\u30C3\u30AF\u306F\u5834\u304C\u6D41\u308C\u308B\u3068\u89E3\u9664\u3055\u308C\u307E\u3059\u3002\n\u9769\u547D\u3068J\u30D0\u30C3\u30AF\u304C\u91CD\u306A\u308B\u3068\u901A\u5E38\u306E\u5F37\u3055\u3067\u3059\u3002"
  - "\u968E\u6BB5 / \u968E\u6BB5\u9769\u547D / \u7E1B\u308A\n\n\u540C\u4E00\u30B9\u30FC\u30C8\u306E\u9023\u756A3\u679A\u4EE5\u4E0A\u304C\u968E\u6BB5\u3067\u3059\u3002\n\u968E\u6BB54\u679A\u4EE5\u4E0A\u3067\u9769\u547D\u30022\u30683\u306F\u3064\u306A\u304C\u308A\u307E\u305B\u3093\u3002\n\u540C\u3058\u30B9\u30FC\u30C8\u69CB\u6210\u304C\u7D9A\u304F\u3068\u7E1B\u308A\u304C\u767A\u52D5\u3057\u307E\u3059\u3002\n\u7E1B\u3089\u308C\u305F\u30B9\u30FC\u30C8\u69CB\u6210\u4EE5\u5916\u306F\u51FA\u305B\u307E\u305B\u3093\u3002"
  - "\u7981\u6B62\u4E0A\u304C\u308A\uFF08\u521D\u671FON\uFF09\n\n\u901A\u5E38\u306E2\u30FB\u9769\u547D\u4E2D\u306E3\u30FB8\u30FB\u30B8\u30E7\u30FC\u30AB\u30FC\u3067\u306F\n\u6700\u5F8C\u306E\u624B\u672D\u3092\u51FA\u3057\u3066\u4E0A\u304C\u308C\u307E\u305B\u3093\u3002\n\u51FA\u3057\u305F\u5834\u5408\u306F\u53CD\u5247\u8CA0\u3051\u3068\u306A\u308A\u3001\u4E0B\u4F4D\u9806\u4F4D\u304C\u78BA\u5B9A\u3057\u307E\u3059\u3002\nJ\u30D0\u30C3\u30AF\u3060\u3051\u3067\u306F\u7981\u6B62\u5BFE\u8C61\u306E2\u30683\u306F\u5165\u308C\u66FF\u308F\u308A\u307E\u305B\u3093\u3002"
  - "\u52B9\u679C\u304C\u91CD\u306A\u3063\u305F\u3089\n\n7\u6E21\u3057 \u2192 10\u6368\u3066
    \u2192 12\u30DC\u30F3\u30D0\u30FC \u306E\u9806\u306B\u9078\u3073\u307E\u3059\u3002\n\u305D\u306E\u5F8C\u3067\u4E0A\u304C\u308A\u30FB\u5834\u306E\u6D41\u308C\u30FB\u6B21\u306E\u624B\u756A\u3092\u51E6\u7406\u3057\u307E\u3059\u3002\n\u5834\u3092\u6D41\u3059\u52B9\u679C\u306F5\u30B9\u30AD\u30C3\u30D7\u3088\u308A\u512A\u5148\u3055\u308C\u307E\u3059\u3002\n\u30B8\u30E7\u30FC\u30AB\u30FC\u304C\u4EE3\u7528\u3057\u305F\u6570\u5B57\u306E\u52B9\u679C\u306F\u767A\u52D5\u3057\u307E\u305B\u3093\u3002"
  - "\u6B21\u306E\u5BFE\u6226\n\n\u521D\u56DE\u306F\u30C0\u30A4\u30E43\u306E\u6240\u6301\u8005\u3001\u6B21\u306F\u524D\u56DE\u6700\u4E0B\u4F4D\u304B\u3089\u3002\n1\u4F4D\u3068\u6700\u4E0B\u4F4D\u306F2\u679A\u30014\u4EBA\u6226\u306E2\u4F4D\u30683\u4F4D\u306F1\u679A\u4EA4\u63DB\u3002\n\u4E0B\u4F4D\u306F\u5F37\u3044\u672D\u3092\u81EA\u52D5\u3067\u6E21\u3057\u307E\u3059\u3002\n\u4E0A\u4F4D\u306F\u8FD4\u3059\u672D\u3092\u9078\u3093\u3067\u300C\u51FA\u3059
    / \u78BA\u5B9A\u300D\u3002"
  - "\u8A2D\u5B9A\u3068\u97F3\u58F0\n\n\u6B6F\u8ECA\u304B\u308912\u30EB\u30FC\u30EB\u3092\u5207\u308A\u66FF\u3048\u307E\u3059\u3002\u521D\u671F\u306F\u3059\u3079\u3066ON\u3002\n\u30EB\u30FC\u30EB\u3068CPU\u8A2D\u5B9A\u306F\u5F85\u6A5F\u4E2D\u306B\u30DB\u30B9\u30C8\u304C\u5909\u66F4\u3057\u307E\u3059\u3002\n\u89E3\u8AACON\u3067\u52B9\u679C\u3092\u8AAD\u307F\u4E0A\u3052\u307E\u3059\u3002\u97F3\u58F0\u8A2D\u5B9A\u306F\u81EA\u5206\u3060\u3051\u3002\n\u97F3\u58F0\uFF1AVOICEVOX:\u305A\u3093\u3060\u3082\u3093"
