  messages:
  - "\u5C0F\u3055\u306A\u4E00\u6B69\u3082\u3001\u3061\u3083\u3093\u3068\u524D\u9032\u3002\n\u4ECA\u65E5\u306F\u81EA\u5206\u306E\u30DA\u30FC\u30B9\u3067\u3044\u3053\u3046\u3002"
  - "\u3072\u3068\u4F11\u307F\u3057\u305F\u3089\u3001\u65B0\u3057\u3044\u666F\u8272\u3002\n\u306E\u3093\u3073\u308A\u3059\u308B\u6642\u9593\u3082\u5927\u5207\u306B\u3002"
  - "\u3042\u306A\u305F\u306E\u3072\u3068\u8A00\u304C\u3001\u3060\u308C\u304B\u306E\u7B11\u9854\u306B\u3002\n\u3084\u3055\u3057\u3055\u304C\u3075\u308F\u308A\u3068\u5E83\u304C\u308A\u305D\u3046\u3002"
  - "\u597D\u304D\u306A\u3053\u3068\u3092\u3001\u3072\u3068\u3064\u697D\u3057\u3082\u3046\u3002\n\u305D\u308C\u3060\u3051\u3067\u7D20\u6575\u306A\u4E00\u65E5\u3002"
  - "\u3067\u304D\u305F\u3053\u3068\u3092\u3001\u3072\u3068\u3064\u6570\u3048\u3066\u307F\u3088\u3046\u3002\n\u6628\u65E5\u306E\u81EA\u5206\u306B\u3082\u62CD\u624B\u3092\u3002"
  - "\u8FF7\u3063\u305F\u3068\u304D\u306F\u3001\u6DF1\u547C\u5438\u3002\n\u5C0F\u3055\u306A\u697D\u3057\u307F\u304C\u898B\u3064\u304B\u308A\u305D\u3046\u3002"
  - "\u3044\u3064\u3082\u306E\u666F\u8272\u306B\u3082\u3001\u5C0F\u3055\u306A\u767A\u898B\u3002\n\u4ECA\u65E5\u306F\u5C11\u3057\u3060\u3051\u9854\u3092\u4E0A\u3052\u3066\u3002"
  - "\u304C\u3093\u3070\u308B\u65E5\u3082\u3001\u4F11\u3080\u65E5\u3082\u3002\n\u3069\u3061\u3089\u306E\u3042\u306A\u305F\u3082\u5927\u5207\u3067\u3059\u3002"
